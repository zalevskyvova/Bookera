{
  "name": "bookera",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync android",
    "build:apk": "npm run sync && powershell -Command \"$env:JAVA_HOME = '$env:USERPROFILE\\.jdks\\jdk17\\jdk-17.0.20.1+1'; $env:ANDROID_HOME = \\\"$env:LOCALAPPDATA\\Android\\Sdk\\\"; cd android; .\\gradlew.bat assembleDebug; Copy-Item 'app\\build\\outputs\\apk\\debug\\app-debug.apk' '..\\Bookera.apk' -Force\"",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.1",
    "@capacitor/status-bar": "^7.0.0",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
